# Development image used to build, test, lint, measure coverage and record the demo without installing a
# toolchain on the host: the official Rust 1.95 image (pinned by digest) plus clippy, rustfmt, llvm-tools
# (coverage), procps (the tests look at /proc), and curl (the demo).
# Build: docker build -f docker/Dockerfile.dev -t gate-dev docker/
FROM rust@sha256:d7482085ff5b415f84dba5647ae71606650bdef00db7aeb69f4b3d170c3e4082
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl procps \
 && rm -rf /var/lib/apt/lists/* \
 && rustup component add clippy rustfmt llvm-tools-preview --toolchain 1.95.0
